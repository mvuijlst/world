# Settings for the WorldSmith server. Copy to server/.env and fill in; .env is never committed.
# Django does not read this file itself: the systemd unit loads it, and the deploy sources it.
# For local work: set -a; . ./.env; set +a

# Required unless DJANGO_DEBUG=1. A long random string, e.g. from:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# "1" for local development only.
DJANGO_DEBUG=0

# Host names the server answers to, comma-separated. The deploy checks the first one.
DJANGO_ALLOWED_HOSTS=world.example.org
